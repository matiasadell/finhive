# Secrets — never commit real credentials
.env
.env.*
!.env.example
*.pem
*.key

# Course/bootcamp reference material — not part of the public project
.reference/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
.uv/

# Jupyter
.ipynb_checkpoints/

# pytest / coverage / mypy
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# MLflow local artifacts
mlruns/
mlartifacts/

# Databricks
.databricks/
.databricks-login.json

# Artefactos generados corriendo código (notebooks/00_demo.py, etc.) --
# reproducibles corriendo el script de nuevo, no se commitean.
outputs/*
!outputs/.gitkeep

# Data — large corpora live in Unity Catalog Volumes, not in git
data/**
!data/sample_docs/
!data/sample_docs/README.md
!data/eval/
!data/eval/golden_set.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code session metadata — not project content
.claude/
