# Copiar a .env (gitignoreado) y completar con valores reales.
# Nunca commitear .env ni pegar estos valores en un chat/PR/issue.

# --- LLM ---
# console.groq.com/keys — free tier real (sin tarjeta), rate-limited.
# Usado tanto para dev local como registrado en Databricks Model Serving
# como External Model tipo "custom" (API OpenAI-compatible), gobernado
# por AI Gateway. Modelos: llama-3.3-70b-versatile (supervisores) /
# llama-3.1-8b-instant (workers).
GROQ_API_KEY=

# --- Databricks ---
# Preferido: autenticar con `databricks auth login --host <workspace-url>`
# (OAuth, no requiere token acá). Estas variables son el fallback si se
# necesita un profile explícito para SDK/scripts no interactivos.
DATABRICKS_HOST=
DATABRICKS_PROFILE=DEFAULT

# --- Datos financieros ---
# fred.stlouisfed.org/docs/api/api_key.html — gratis, macro data (tasas, CPI, GDP)
FRED_API_KEY=
# alphavantage.co/support/#api-key — free tier, fundamentals + news sentiment
ALPHA_VANTAGE_API_KEY=
# tavily.com — free tier, web search fallback para CRAG.
# IMPORTANTE: no reusar la key vieja del notebook del bootcamp (quedó expuesta
# en el historial de git de otro proyecto) — generar una nueva.
TAVILY_API_KEY=

# --- Observabilidad ---
# smith.langchain.com — free tier
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finhive
LANGSMITH_TRACING=true

# --- Sin key necesaria (documentado para referencia) ---
# yfinance          -> no requiere key
# SEC EDGAR         -> no requiere key, solo un User-Agent con email de contacto real
# CoinGecko (free)  -> no requiere key
SEC_EDGAR_USER_AGENT="FinHive research-agent contact@example.com"
