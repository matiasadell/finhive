# Copiar a .env (gitignoreado) y completar con valores reales.
# Nunca commitear .env ni pegar estos valores en un chat/PR/issue.

# --- Backend de datos ---
# "local" (default): lee los CSVs sintéticos de data/sample_docs/ vía pandas --
# lo que corre en esta máquina de desarrollo (sin acceso a Databricks).
# "databricks": lee las tablas Delta reales en Unity Catalog vía el SQL
# warehouse -- solo funciona en la compu de trabajo, con DATABRICKS_HOST/
# DATABRICKS_TOKEN/SQL_WAREHOUSE_ID configurados abajo. Ver
# prompts/constraints_environment.md.
PORTFOLIO_INTEL_DATA_BACKEND=local

# --- LLM ---
# Sin key adicional para los endpoints directos: se usan los Foundation Model
# APIs nativos de Databricks (Llama 3.3 70B / Llama 3.1 8B), ya READY en el
# workspace, incluidos gratis en Free Edition. Solo funcionan con
# DATABRICKS_CONFIG_PROFILE configurado y conexión real al workspace -- desde
# esta máquina de desarrollo no hay conexión, así que cualquier invocación
# real del grafo falla acá a propósito (ver prompts/constraints_environment.md);
# recién anda en la compu de trabajo.

# --- Databricks ---
# Autenticación principal (databricks-sdk / databricks-langchain):
# `databricks auth login --host <workspace-url>` (OAuth). El databricks-sdk no lee
# el "default_profile" de ~/.databrickscfg -- hace falta esta env var explícita.
DATABRICKS_CONFIG_PROFILE=

# Usado por el backend "databricks" del data store (Statement Execution API
# contra el SQL warehouse) y por autenticación explícita donde haga falta un
# token fijo. Generar con: databricks tokens create --lifetime-seconds <n>
# En un notebook/endpoint de serving estos ya vienen del secret scope
# `portfolio_intel` (infra/databricks/setup_secrets.py) -- esto de acá es solo
# para esta máquina de desarrollo.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# ID del SQL warehouse serverless que sirve las tablas Delta de
# workspace.portfolio_intel (solo necesario con PORTFOLIO_INTEL_DATA_BACKEND=databricks).
SQL_WAREHOUSE_ID=
