# Copiar a .env (gitignoreado) y completar con valores reales.
# Nunca commitear .env ni pegar estos valores en un chat/PR/issue.

# --- LLM ---
# Sin key adicional para los endpoints directos: se usan los Foundation Model
# APIs nativos de Databricks (system.ai.llama_v3_3_70b_instruct /
# meta_llama_v3_1_8b_instruct / gte_large_en_v1_5), ya READY en el workspace,
# incluidos gratis en Free Edition (sin tarjeta, sin facturación posible —
# ver ADR 0003).
#
# El top-level supervisor SÍ pasa por Unity AI Gateway con routing real entre
# dos modelos (ADR 0009/0010) vía un cliente OpenAI-compatible — para eso
# hacen falta DATABRICKS_HOST y DATABRICKS_TOKEN abajo.

# --- Databricks ---
# Autenticación principal (databricks-sdk / databricks-langchain / unitycatalog-ai):
# `databricks auth login --host <workspace-url>` (OAuth). El databricks-sdk no lee
# el "default_profile" de ~/.databrickscfg -- hace falta esta env var explícita.
DATABRICKS_CONFIG_PROFILE=

# Usado SOLO por el cliente OpenAI-compatible contra AI Gateway
# (get_router_chat_model / get_gateway_embeddings) — ChatDatabricks usa OAuth
# arriba, no esto. Generar con: databricks tokens create --lifetime-seconds <n>
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Datos financieros ---
# fred.stlouisfed.org/docs/api/api_key.html — gratis, macro data (tasas, CPI, GDP)
FRED_API_KEY=
# alphavantage.co/support/#api-key — free tier, fundamentals + news sentiment
ALPHA_VANTAGE_API_KEY=
# tavily.com — free tier, web search fallback para CRAG.
# IMPORTANTE: no reusar la key vieja del notebook del bootcamp (quedó expuesta
# en el historial de git de otro proyecto) — generar una nueva.
TAVILY_API_KEY=

# --- Sin key necesaria (documentado para referencia) ---
# yfinance          -> no requiere key
# SEC EDGAR         -> no requiere key, solo un User-Agent con email de contacto real
# CoinGecko (free)  -> no requiere key
SEC_EDGAR_USER_AGENT="FinHive research-agent contact@example.com"
